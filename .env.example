# アイボウくん -- 環境変数テンプレート
# このファイルを .env.local にコピーして実際の値を設定してください
# .env.local は絶対にコミットしないでください

# ===== Database =====
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aiboukun_dev"

# ===== Auth.js =====
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# ===== Token Encryption =====
TOKEN_ENCRYPTION_KEY="64-char-hex-string"

# ===== Google OAuth =====
# Google Cloud Console > API & Services > Credentials で作成
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===== Google Business Profile API =====
# Google Cloud Console で有効化: "Business Profile API"
# OAuth スコープ: https://www.googleapis.com/auth/business.manage
GOOGLE_BUSINESS_PROFILE_API_BASE="https://mybusinessaccountmanagement.googleapis.com"

# ===== LLM Provider (開発時: Gemini) =====
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# ===== LLM Provider (商用切替用: 未使用時はコメントアウト) =====
# LLM_PROVIDER="openai"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"

# LLM_PROVIDER="anthropic"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-4-6"

# ===== Email (通知用) =====
# 開発時はコンソール出力でもOK
EMAIL_FROM="noreply@aiboukun.jp"
# RESEND_API_KEY="re_..."
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user"
# SMTP_PASS="pass"

# ===== App =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
